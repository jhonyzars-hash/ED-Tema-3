<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jhonysiystem.estructurasnolineales.controller.MenuArbolesController"
            prefWidth="600" prefHeight="400">

    <Label layoutX="20" layoutY="15"
           text="Menú de Árboles (BST)"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label layoutX="20" layoutY="55" text="Valores (separados por coma):" />
    <TextField fx:id="txtValores" layoutX="190" layoutY="50" prefWidth="380"
               promptText="Ej: 8,3,10,1,6,14,4,7,13"/>

    <Label layoutX="20" layoutY="90" text="Buscar valor:" />
    <TextField fx:id="txtBuscar" layoutX="190" layoutY="85" prefWidth="120"
               promptText="Ej: 7"/>

    <!-- 4 ejercicios -->
    <Button layoutX="20" layoutY="125" prefWidth="150"
            text="1) Insertar valores" onAction="#onInsertar"/>

    <Button layoutX="180" layoutY="125" prefWidth="150"
            text="2) Recorridos" onAction="#onRecorridos"/>

    <Button layoutX="340" layoutY="125" prefWidth="150"
            text="3) Buscar" onAction="#onBuscar"/>

    <Button layoutX="500" layoutY="125" prefWidth="90"
            text="4) Altura" onAction="#onAltura"/>

    <TextArea fx:id="txtSalida" layoutX="20" layoutY="170" prefWidth="570" prefHeight="170"
              promptText="Aquí se mostrarán los resultados..."/>

    <Button layoutX="20" layoutY="350" prefWidth="120"
            text="Limpiar" onAction="#onLimpiar"/>

    <Button layoutX="470" layoutY="350" prefWidth="120"
            text="Regresar" onAction="#onRegresar"/>
</AnchorPane>
