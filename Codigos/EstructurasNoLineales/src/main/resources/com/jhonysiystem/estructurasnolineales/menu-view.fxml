<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jhonysiystem.estructurasnolineales.controller.MainController"
            prefWidth="600" prefHeight="400">

    <Label layoutX="235" layoutY="80"
           text="Selecciona un menú"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Button layoutX="240" layoutY="140"
            text="Árboles"
            prefWidth="120"
            onAction="#onArboles"/>

    <Button layoutX="240" layoutY="190"
            text="Grafos"
            prefWidth="120"
            onAction="#onGrafos"/>

    <Button layoutX="240" layoutY="260"
            text="Regresar"
            prefWidth="120"
            onAction="#onRegresar"/>
</AnchorPane>
