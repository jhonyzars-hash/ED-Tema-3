<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jhonysiystem.estructurasnolineales.controller.MenuGrafosController"
            prefWidth="600" prefHeight="400">

    <Label layoutX="20" layoutY="15"
           text="Menú de Grafos (no dirigido)"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label layoutX="20" layoutY="55" text="Vértice:"/>
    <TextField fx:id="txtVertice" layoutX="85" layoutY="50" prefWidth="90" promptText="Ej: A"/>

    <Label layoutX="190" layoutY="55" text="Origen:"/>
    <TextField fx:id="txtOrigen" layoutX="240" layoutY="50" prefWidth="90" promptText="Ej: A"/>

    <Label layoutX="345" layoutY="55" text="Destino:"/>
    <TextField fx:id="txtDestino" layoutX="405" layoutY="50" prefWidth="90" promptText="Ej: B"/>

    <Label layoutX="20" layoutY="90" text="Inicio (BFS/DFS):"/>
    <TextField fx:id="txtInicio" layoutX="140" layoutY="85" prefWidth="90" promptText="Ej: A"/>

    <!-- 4 ejercicios -->
    <Button layoutX="20" layoutY="125" prefWidth="150"
            text="1) Agregar" onAction="#onAgregar"/>

    <Button layoutX="180" layoutY="125" prefWidth="150"
            text="2) Mostrar" onAction="#onMostrar"/>

    <Button layoutX="340" layoutY="125" prefWidth="120"
            text="3) BFS" onAction="#onBfs"/>

    <Button layoutX="470" layoutY="125" prefWidth="120"
            text="4) DFS" onAction="#onDfs"/>

    <TextArea fx:id="txtSalida" layoutX="20" layoutY="170" prefWidth="570" prefHeight="170"
              promptText="Aquí se mostrarán los resultados..."/>

    <Button layoutX="20" layoutY="350" prefWidth="120"
            text="Limpiar" onAction="#onLimpiar"/>

    <Button layoutX="470" layoutY="350" prefWidth="120"
            text="Regresar" onAction="#onRegresar"/>
</AnchorPane>
