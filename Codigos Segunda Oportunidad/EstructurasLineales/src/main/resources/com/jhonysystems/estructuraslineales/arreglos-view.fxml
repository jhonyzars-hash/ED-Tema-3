<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="600" prefHeight="400"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jhonysystems.estructuraslineales.controller.MainController">

    <Label text="Dato:" layoutX="40" layoutY="40"/>
    <TextField fx:id="txtArreglos" layoutX="120" layoutY="35" prefWidth="200"/>

    <Button text="Insertar" layoutX="40" layoutY="90" onAction="#insertarArreglo"/>

    <TextArea fx:id="areaArreglos"
              layoutX="40" layoutY="150"
              prefWidth="520" prefHeight="200"/>

</AnchorPane>
